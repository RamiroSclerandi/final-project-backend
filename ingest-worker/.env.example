# MQTT broker (HiveMQ Cloud, TLS)
MQTT_HOST=xxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=worker
MQTT_PASSWORD=
MQTT_TOPIC_DATA=dl/v1/+/data
MQTT_TOPIC_STATUS=dl/v1/+/status

# Client id prefix. A per-process uuid4 suffix is appended at runtime so that
# an overlapping deploy cannot trigger the MQTT-3.1.4-2 mutual disconnect loop.
MQTT_CLIENT_ID_PREFIX=ingest-worker

# Optional path to a custom CA bundle. Leave empty to use the system/certifi
# bundle. Pending spike S2.
MQTT_CA_CERT_PATH=

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Ingestion queue and batching
INGEST_QUEUE_MAX=1000
MQTT_MAX_PAYLOAD_BYTES=16384
BATCH_MAX_SIZE=100
BATCH_MAX_AGE_MS=2000
REGISTRY_CACHE_TTL_S=900

LOG_LEVEL=INFO
